{
  "name": "virtual-fit-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json && npm run web:build",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "test:ui": "playwright test",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed-cli.ts",
    "admin:create": "tsx src/create-admin.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/static": "10.1.5",
    "@sinclair/typebox": "^0.34.0",
    "bullmq": "^5.0.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.0.0",
    "pg": "^8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.0.0",
    "lucide-react": "^0.577.0",
    "three": "^0.183.0"
  },
  "overrides": { "esbuild": "0.28.2" },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.0",
    "@playwright/test": "^1.58.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.3"
  }
}
