NODE_ENV=development
HOST=127.0.0.1
PORT=3100
DB_MODE=pglite
PGLITE_PATH=.data/postgres
DATABASE_URL=postgres://virtualfit:change-me@localhost:5432/virtualfit
QUEUE_MODE=local
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://127.0.0.1:3100
CORS_ORIGINS=http://localhost:3000
TRYON_PROVIDER=demo
# http provider must implement the contract documented in docs/ARCHITECTURE.md
VTON_ENDPOINT=
VTON_API_KEY=
VTON_MODEL_VERSION=http-provider-v1
WEBHOOK_SECRET=
RESULT_HOSTS=
# Only used by npm run admin:create; never returned by the API.
ADMIN_EMAIL=
ADMIN_PASSWORD=
