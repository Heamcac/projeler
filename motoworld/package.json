{
  "name": "motoworld",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "lint": "eslint .",
    "test": "tsx --test tests/*.unit.test.ts",
    "test:integration": "tsx tests/with-postgres.ts integration",
    "test:e2e": "tsx tests/with-postgres.ts e2e",
    "import:sqlite": "tsx prisma/import-sqlite.ts",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.13.0",
    "bcryptjs": "^3.0.0",
    "dotenv": "^18.0.10",
    "next": "^16.0.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
